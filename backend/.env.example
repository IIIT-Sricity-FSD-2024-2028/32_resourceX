# Copy this file to backend/.env and fill in SMTP_USER and SMTP_PASS to send real emails.
# While SMTP_USER or SMTP_PASS is empty, password reset codes are printed in the backend console instead.
#
# Gmail example: turn on 2-Step Verification for the sending account, then create an
# App Password at https://myaccount.google.com/apppasswords and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ResourceX
